App(
    appid="ble_scanner",
    name="BLE Scanner",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="ble_scanner_app",
    requires=["gui", "bt"],
    stack_size=4 * 1024,
    fap_category="Bluetooth",
    fap_version=(1, 0),
    fap_icon="icons/ble_scanner_10x10.png",
    fap_icon_assets="icons",
    fap_author="@LazyCat",
    fap_description="Scan for nearby BLE devices and display their names, addresses, and RSSI",
)
